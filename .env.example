# Copy to .env (never commit it) only when you want a REAL judge. The default offline judge
# needs none of this. DeepEval reads a .env file in the project folder automatically.

# Which judge scores the metrics: offline | openai | azure | bedrock
JUDGE=offline

# Don't send usage telemetry to DeepEval
DEEPEVAL_TELEMETRY_OPT_OUT=1

# --- OpenAI (JUDGE=openai) ---
OPENAI_API_KEY=
# Optional. Leave blank for DeepEval's default judge model.
JUDGE_MODEL=

# --- Azure OpenAI (JUDGE=azure) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_DEPLOYMENT_NAME=
AZURE_MODEL_NAME=
OPENAI_API_VERSION=

# --- AWS Bedrock (JUDGE=bedrock, also `pip install aiobotocore`) ---
# Credentials come from the normal AWS chain (profile, SSO or environment variables).
AWS_BEDROCK_MODEL_NAME=
AWS_BEDROCK_REGION=eu-west-2
